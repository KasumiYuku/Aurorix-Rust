{
  "port": 8080,
  "listen_addr": "127.0.0.1",
  "appid": "你的机器人 AppID",
  "secret": "你的机器人 AppSecret",
  "proxy": "https://api.bot.qq.com",
  "protocol": "websocket",
  "intents": [
    "GROUP_AT_MESSAGE_CREATE",
    "GROUP_MESSAGE_CREATE",
    "C2C_MESSAGE_CREATE",
