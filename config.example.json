  "render_pool": 4,
  "global_markdown": false,
  "plugin_settings": {
    "example-rating": {
      "backend_url": "http://127.0.0.1:2388"
    }
  },
  "plugin_access": {
    "example-rating": {
      "default": { "mode": "on" }
    }
